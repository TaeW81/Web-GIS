# ============================================================
# KH LandHub — 웹 배포용 secrets 예시
# ------------------------------------------------------------
# 사용법:
#   - 로컬: 이 파일을 참고만 (로컬은 .env 사용, 로그인 없음)
#   - 웹 배포(Streamlit Community Cloud 등): 호스팅의 "Secrets" 칸에
#     아래 내용을 채워 붙여넣기. (이 .example 파일은 깃에 올라가도 안전 —
#     실제 값이 든 secrets.toml 은 .gitignore 로 제외됨)
# ============================================================

# --- 웹 모드 ON (데스크톱 기능 숨김 + 로그인 보호 활성화) ---
KH_WEB_MODE = "1"

# --- 공공기관 API 키 (실제 발급키로 교체) ---
VWORLD_KEY = "여기에-VWorld-키"
NIE_KEY    = "여기에-국립생태원-키"
NGII_KEY   = "여기에-국토지리정보원-키"
ECVAM_KEY  = "여기에-국토환경성평가-키"

# ============================================================
# 로그인 (사용자별) — streamlit-authenticator
#   비밀번호는 반드시 "해시값"으로 넣어야 합니다(평문 금지).
#   해시 생성 방법:
#     python -c "import streamlit_authenticator as s; print(s.Hasher(['평문비번']).generate())"
# ============================================================
[auth.cookie]
name = "kh_landhub_auth"
key = "여기에-임의의-긴-서명문자열"   # 아무도 모르는 랜덤 문자열로 교체
expiry_days = 7

[auth.credentials.usernames.hong]
email = "hong@example.com"
name = "홍길동"
password = "$2b$12$여기에-bcrypt-해시값"

[auth.credentials.usernames.kim]
email = "kim@example.com"
name = "김설계"
password = "$2b$12$여기에-bcrypt-해시값"
